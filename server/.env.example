# ---- API en producción / con Atlas real (npm run dev o npm start en server/) ----
# Puerto donde escucha la API Express
PORT=4000
# Orígenes permitidos por CORS, separados por coma (dirección exacta del frontend,
# con su puerto). Vite usa 5173 y salta a 5174 si está ocupado: lista ambos o el
# navegador bloqueará todas las peticiones.
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Cadena de conexión de MongoDB Atlas. La base del proyecto es UTM_Desk y las
# colecciones que escribe Mongoose son users, counters, articulos e incidencias.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/UTM_Desk?retryWrites=true&w=majority
# Secret para firmar los JWT: valor largo y aleatorio (openssl rand -hex 32)
JWT_SECRET=pon-aqui-un-valor-aleatorio-largo
# ---- Almacenamiento: Supabase Storage (buckets PRIVADOS) ----
# URL del proyecto, completa y con esquema: sin ella la API responde 503 a cualquier subida.
SUPABASE_URL=https://xxxxx.supabase.co
# Clave con permisos de storage. El nombre actual es SUPABASE_SECRET_KEY;
# SUPABASE_SERVICE_KEY se sigue aceptando por compatibilidad. Solo existe en el servidor:
# nunca va en el cliente ni en una variable VITE_, y nunca se imprime en los logs.
# DEBE ser la clave SECRET (sb_secret_... o la antigua service_role). La publishable
# (sb_publishable_...) y la anon NO sirven aunque sean validas: la subida la hace este
# servidor sin sesion de Supabase Auth, asi que Supabase la trata como el rol "anon" y las
# politicas RLS del bucket la rechazan con "new row violates row-level security policy".
# Se comprueba sin tocar datos de la app con: node probar-storage.mjs
SUPABASE_SECRET_KEY=secret-key-solo-servidor
#SUPABASE_SERVICE_KEY=service-role-key-solo-servidor
# Buckets donde clasifica server/archivos.js según la operación de la app:
#   fotos y capturas de un expediente   -> incidencias-evidencias   (10 MB por archivo)
#   PDF, Word, Excel y TXT de un expediente -> incidencias-documentos (20 MB por archivo)
#   foto de perfil                      -> usuarios-archivos        (5 MB por archivo)
# Si tu proyecto aún no tiene esos nombres, apunta cada variable al bucket QUE YA EXISTE
# (no se crean buckets desde el código) y la clasificación, los límites y los permisos
# siguen aplicando igual.
SUPABASE_BUCKET_EVIDENCIAS=incidencias-evidencias
SUPABASE_BUCKET_DOCUMENTOS=incidencias-documentos
SUPABASE_BUCKET_PERFILES=usuarios-archivos
# Bucket histórico: se usa solo para firmar las referencias guardadas antes de la
# clasificación por operación. Las evidencias nuevas heredan de aquí su nombre si no
# defines SUPABASE_BUCKET_EVIDENCIAS.
SUPABASE_BUCKET=evidencias
# Días que conserva MongoDB una incidencia resuelta/cerrada antes de borrarla (TTL).
# 0 desactiva el índice ttl_resolucion.
TTL_DIAS=60
# Intentos de login/registro por IP cada 15 minutos
AUTH_RATE=10
# Cuenta de Soporte TI que bootstrap() crea si no existe (se migra de "admin")
ADMIN_EMAIL=soporte@utm.edu.mx
ADMIN_PASSWORD=cambia-esta-clave

# ---- Solo para npm run dev:local (base en memoria, sin Atlas ni Supabase) ----
# API de desarrollo; las evidencias se sirven en DEV_PORT+1
#DEV_PORT=4100
# Orígenes del cliente Vite durante el desarrollo
#DEV_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Contraseña de las cuentas semilla (por defecto Demo.2026)
#DEMO_PASSWORD=Demo.2026

# ---- TLS inspeccionado por el antivirus (Windows) ----
# Si el arranque o node probar-storage.mjs falla con "fetch failed" y el detalle es
# UNABLE_TO_VERIFY_LEAF_SIGNATURE, el antivirus (Avast Web/Mail Shield y otros) esta
# reemplazando el certificado de *.supabase.co por uno de su propia raiz, que Node no
# conoce. Loresuelve que Node use el almacen CA de Windows, donde esa raiz si esta:
#   npm run dev            (los scripts ya traen --use-system-ca)
#   node --use-system-ca index.js
# Alternativa, exportandola a un PEM:
#   powershell -NoProfile -ExecutionPolicy Bypass -File exportar-ca-antivirus.ps1
#   set NODE_EXTRA_CA_CERTS=%TEMP%\ca-antivirus.pem
