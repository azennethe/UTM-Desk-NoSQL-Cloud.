# ---- API en producción / con Atlas real (npm run dev o npm start en server/) ----
# Puerto donde escucha la API Express
PORT=4000
# Orígenes permitidos por CORS, separados por coma (dirección exacta del frontend,
# con su puerto). Vite usa 5173 y salta a 5174 si está ocupado: lista ambos o el
# navegador bloqueará todas las peticiones.
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Cadena de conexión de MongoDB Atlas. La base del proyecto es UTM_Desk y las
# colecciones que escribe Mongoose son users, counters, articulos e incidencias.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/UTM_Desk?retryWrites=true&w=majority
# Secret para firmar los JWT: valor largo y aleatorio (openssl rand -hex 32)
JWT_SECRET=pon-aqui-un-valor-aleatorio-largo
# Bucket PRIVADO de Supabase Storage donde viven las evidencias
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-solo-servidor
SUPABASE_BUCKET=evidencias
# Días que conserva MongoDB una incidencia resuelta/cerrada antes de borrarla (TTL).
# 0 desactiva el índice ttl_resolucion.
TTL_DIAS=60
# Intentos de login/registro por IP cada 15 minutos
AUTH_RATE=10
# Cuenta de Soporte TI que bootstrap() crea si no existe (se migra de "admin")
ADMIN_EMAIL=soporte@utm.edu.mx
ADMIN_PASSWORD=cambia-esta-clave

# ---- Solo para npm run dev:local (base en memoria, sin Atlas ni Supabase) ----
# API de desarrollo; las evidencias se sirven en DEV_PORT+1
#DEV_PORT=4100
# Orígenes del cliente Vite durante el desarrollo
#DEV_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Contraseña de las cuentas semilla (por defecto Demo.2026)
#DEMO_PASSWORD=Demo.2026
